<Project>
  <!--
    Versions mirror Jellyfin 12.3 so the plugin loads against exactly what the server ships:
    https://github.com/jellyfin/jellyfin/blob/v12.3/Directory.Packages.props
    Bump them together with the Jellyfin.* packages. A new Jellyfin minor version also moves the plugin
    version line: update targetAbi in build.yaml and Version in Directory.Build.props (see README, Versioning).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Jellyfin">
    <PackageVersion Include="Jellyfin.Controller" Version="12.3.0" />
    <PackageVersion Include="Jellyfin.Model" Version="12.3.0" />
  </ItemGroup>

  <ItemGroup Label="Microsoft.Extensions (shared with the server)">
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Analyzers">
    <PackageVersion Include="SerilogAnalyzer" Version="0.15.0" />
    <PackageVersion Include="SmartAnalyzers.MultithreadingAnalyzer" Version="1.1.31" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>
</Project>
